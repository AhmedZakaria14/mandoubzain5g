{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mandoubzain5g",
  "compatibility_date": "2026-07-29",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "worker.mjs"
}
